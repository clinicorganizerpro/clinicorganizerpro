{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "noEmit": false,
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["./**/*.ts"]
}
