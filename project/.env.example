NODE_ENV=development
PORT=8788

# Frontend
VITE_API_URL=http://localhost:8788
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key

# Production URLs / CORS
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Supabase backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=change-me-use-a-long-random-secret
ACCESS_TOKEN_SECRET=change-me-use-a-long-random-secret
REFRESH_TOKEN_SECRET=change-me-use-another-long-random-secret

# Stripe recurring billing
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ESSENCIAL=price_your_essencial_monthly_price
STRIPE_PRICE_PRO=price_your_pro_monthly_price
STRIPE_PRICE_CLINIC=price_your_clinic_monthly_price

# OpenAI optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Hugging Face fallback optional
HF_API_KEY=
HF_MODEL=gpt2
